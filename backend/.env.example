# Copy to .env. Keep existing MySQL tables; create iot_db first if needed.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/iot_db?charset=utf8mb4
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1884
MQTT_USERNAME=B23DCCN294
MQTT_PASSWORD=
MQTT_SENSOR_TOPIC=esp32/sensor/data
# Map existing database device IDs to firmware LED names. Check GET /api/devices.
MQTT_DEVICE_MAP={"1":"led1","2":"led2","3":"led3"}
COMMAND_TIMEOUT_SECONDS=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
